{
  "schema_version": 2,
  "id": "com.tencent.qq-local",
  "platform": "macos",
  "application_id": "com.tencent.qq",
  "states": {
    "password": {
      "kind": "login_page",
      "controls": {
        "password": {
          "role": "secure_text_field",
          "names": [
            "输入QQ密码"
          ],
          "identifier": null,
          "ancestor": null
        },
        "submit": {
          "role": "button",
          "names": [
            "登录"
          ],
          "identifier": null,
          "ancestor": null
        },
        "username": {
          "role": "text_field",
          "names": [
            "输入QQ号"
          ],
          "identifier": null,
          "ancestor": null
        }
      }
    },
    "home": {
      "kind": "logged_in",
      "controls": {
        "menu": {
          "role": "button",
          "names": [
            "更多"
          ],
          "descendant": {
            "role": "button",
            "names": [
              "更多"
            ]
          }
        },
        "logout": {
          "role": "menu_item",
          "names": [
            "退出账号"
          ],
          "ancestor": {
            "role": "menu_item",
            "names": [
              "QQ"
            ]
          }
        },
        "app_menu": {
          "role": "menu_item",
          "names": [
            "QQ"
          ],
          "ancestor": {
            "role": "menu"
          }
        }
      }
    },
    "quick_login": {
      "kind": "intermediate",
      "controls": {
        "password_login": {
          "role": "button",
          "names": [
            "账密登录"
          ]
        }
      }
    }
  },
  "flows": {
    "fill": {
      "kind": "login",
      "timeout_ms": 120000,
      "steps": [
        {
          "type": "fill",
          "state": "password",
          "target": "username",
          "field": "username"
        },
        {
          "type": "fill",
          "state": "password",
          "target": "password",
          "field": "password"
        }
      ],
      "outcome": "filled"
    },
    "logout": {
      "kind": "logout",
      "timeout_ms": 30000,
      "outcome": "logged_out",
      "steps": [
        {
          "type": "click",
          "state": "home",
          "target": "app_menu",
          "next_state": "home"
        },
        {
          "type": "click",
          "state": "home",
          "target": "logout",
          "next_state": "quick_login",
          "expect_restart": true
        },
        {
          "type": "click",
          "state": "quick_login",
          "target": "password_login",
          "next_state": "password"
        },
        {
          "type": "wait_state",
          "state": "password"
        }
      ]
    }
  }
}
