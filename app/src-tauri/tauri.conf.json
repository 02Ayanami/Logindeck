{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LoginDeck",
  "version": "0.1.1",
  "identifier": "com.autologin.desktop",
  "build": {
    "beforeDevCommand": "node ../scripts/prepare-edge-bundle.mjs && pnpm dev",
    "beforeBuildCommand": "node ../scripts/prepare-edge-bundle.mjs && pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "LoginDeck",
        "width": 1120,
        "height": 780,
        "minWidth": 720,
        "minHeight": 540
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/edge/": "edge/"
    }
  }
}
